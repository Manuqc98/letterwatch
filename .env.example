# ==============================================================================
# Letterwatch - Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y completa los valores:
#   cp .env.example .env
#
# Para obtener tu API Key gratuita de TheMovieDatabase (TMDB):
# 1. Regístrate o inicia sesión en https://www.themoviedb.org/
# 2. Ve a Configuración > API (https://www.themoviedb.org/settings/api)
# 3. Solicita una clave de desarrollador y cópiala aquí.
# ==============================================================================

# API Key v3 de TMDB (Requerida para buscar películas, pósters y proveedores de streaming)
EXPO_PUBLIC_TMDB_API_KEY=tu_tmdb_api_key_aqui

# Token de lectura v4 de TMDB (Opcional)
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=tu_tmdb_read_access_token_aqui
